# Self-hosted Cosmos EVM profile. Fill in all keys locally; never commit the resulting .env.
CHAIN_ID=262144
CHAIN_RPC_URL=http://127.0.0.1:8545
CHAIN_WS_URL=ws://127.0.0.1:8545
CONTRACT_ADDRESS=
CONFIRMATIONS=1
DEPLOYER_PRIVATE_KEY=

COSMOS_CHAIN_ID=262144
COSMOS_RPC_URL=http://127.0.0.1:8545
COSMOS_DEPLOYER_PRIVATE_KEY=

# App services
API_PORT=3000
KEY_SERVICE_PORT=3001
KEY_SHARE_INDEX=1
KEY_SHARE_PRIVATE_KEY_FILE=.keys/key-holder-1.json
KEY_PACKAGE_CACHE_DIR=.keys/packages
API_BASE_URL=http://localhost:3000
KEY_HOLDER_URLS=http://127.0.0.1:3001,http://127.0.0.1:3002,http://127.0.0.1:3003,http://127.0.0.1:3004,http://127.0.0.1:3005
WEB_ORIGIN=http://localhost:5173

# S3-compatible object store (MinIO for local development)
S3_ENDPOINT=http://127.0.0.1:9000
S3_REGION=us-east-1
S3_BUCKET=
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_FORCE_PATH_STYLE=true

# Committee/key-holder EVM signer, share-holder key, and entropy-relayer secrets
KEY_SERVICE_SIGNER_PRIVATE_KEY=
COMMITTEE_PRIVATE_KEY=
RELAYER_PRIVATE_KEY=
ENTROPY_PROVIDER=anu
ANU_API_URL=
ANU_API_KEY=
