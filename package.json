{
    "name": "eplp",
    "private": true,
    "type": "module",
    "packageManager": "pnpm@12.21.0",
    "engines": {
        "node": ">=24"
    },
    "scripts": {
        "dev": "node apps/cli/src/dev.ts",
        "e2e": "pnpm -C apps/cli e2e",
        "eplp": "node apps/cli/src/main.ts",
        "build": "pnpm -C packages/contracts build && pnpm -r --filter ./apps/exam-client --filter ./apps/portal build",
        "typecheck": "pnpm -r --parallel typecheck",
        "test": "pnpm -C packages/contracts test && pnpm -C packages/protocol test"
    }
}
